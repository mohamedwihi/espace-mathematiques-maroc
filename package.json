{
  "name": "espace-mathematiques-maroc",
  "private": true,
  "version": "0.1.0",
  "description": "فضاء الرياضيات بالمغرب — Espace Mathématiques Maroc : plateforme éducative de mathématiques pour le collège et le lycée marocains.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:math": "vite-node scripts/check-math.ts",
    "pdf": "vite-node scripts/build-pdfs.ts"
  },
  "dependencies": {
    "katex": "0.16.11",
    "lucide-react": "0.460.0",
    "mafs": "0.19.0",
    "mathjs": "13.2.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0"
  },
  "devDependencies": {
    "@types/katex": "0.16.7",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.15",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.5"
  },
  "engines": {
    "node": ">=18.18"
  }
}
